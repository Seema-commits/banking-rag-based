# Copy to frontend/.env to change these (optional; these are the defaults).

# Preferred port for the dev server. If it's busy, Vite picks the next free port and prints the URL.
FRONTEND_PORT=5175

# Where the backend runs. Must match PORT in backend/.env.
BACKEND_URL=http://localhost:8731

# Branding shown in the header and browser tab.
VITE_APP_TITLE=Thistlewood Bank Assistant
# Notice under the header. Set to an empty value (VITE_DISCLAIMER=) to hide it.
VITE_DISCLAIMER=Portfolio demo. Thistlewood Bank is fictional and not affiliated with any bank or the RBI. Not financial advice. Do not enter personal or account details.
