# Copy to backend/.env and fill in.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secret the admin types into the Admin page to upload/delete documents.
ADMIN_API_KEY=change-me

# Hugging Face embedding model (downloaded on first start)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Remove lines repeated on most pages (headers, footers, page numbers) before chunking.
STRIP_REPEATED_LINES=true
TOP_K=4
# vector = embeddings only; hybrid = embeddings + BM25 keyword search (reciprocal rank fusion).
RETRIEVAL_MODE=hybrid

# Agent checks (each adds a Groq call): the LLM grades the retrieved chunks and decides to answer,
# retry the search or refuse; the grounding check verifies the answer against the sources.
SELF_CORRECTION=true
GROUNDING_CHECK=true
MAX_QUERY_REWRITES=1
MAX_REGENERATIONS=1
# Reasoning effort for the agent's internal checks on reasoning models (gpt-oss): low = faster.
CHECK_REASONING_EFFORT=low

# Web search tool (Tavily, https://tavily.com, free tier): used only when the documents don't
# answer a banking question, and only on the sites below. Leave the key empty to turn it off.
TAVILY_API_KEY=
WEB_SEARCH_DOMAINS=["rbi.org.in","uidai.gov.in","incometax.gov.in","npci.org.in"]

# Store questions (PII-masked), answers and feedback for the admin Insights tab.
STORE_INTERACTIONS=true
# Minimum relevance (0-1) for a chunk to be used; below it the bot says "not found". 0 disables.
RELEVANCE_THRESHOLD=0.15
MAX_UPLOAD_MB=25

# Port for `python run.py`. The frontend's BACKEND_URL (frontend/.env) must use the same port.
PORT=8731

# Extra allowed frontend origins as a JSON list (any localhost port is already allowed),
# e.g. CORS_ORIGINS=["https://my-deployed-site.example"]
CORS_ORIGINS=[]

# Public chat limits (0 disables a limit).
CHAT_REQUESTS_PER_MINUTE_PER_IP=10
CHAT_REQUESTS_PER_DAY=500

# Index the PDFs in this folder at startup when the knowledge base is empty (used in Docker).
# SEED_DOCS_DIR=../sample-docs/thistlewood
